# Simple Assertion Demo
# ====================
# Quick test to show assertions working

use(std::{print, assert, assert_eq, assert_neq, assert_lt, assert_gt})

runSimpleAssertionDemo = || {
  print("=== Simple Assertion Demo ===")
  assert(true)
  assert(5 > 3)
  assert_eq(2 + 2, 4)
  assert_eq("hello", "hello")
  assert_neq(5, 3)
  assert_neq(true, false)
  assert_lt(1, 5)
  assert_gt(10, 2)
  testVec1 = [1, 2, 3]
  testVec2 = [1, 2, 3]
  assert_eq(testVec1, testVec2)
  print("All assertions passed!")
}

runSimpleAssertionDemo()
