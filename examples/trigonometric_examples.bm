# Trigonometric Function Examples
# =============================
# This file demonstrates trigonometric functions in BMath language.

use "std" as std
use std::{print, sin, cos, tan, cot, sec, csc, pi, sqrt}

runTrigonometricExamples = || {
  print("=== Trigonometric Examples ===")

  # [1] Basic Trigonometric Functions
  sineZero = sin(0)
  sinePiHalf = sin(std::pi/2)
  sineMinusPiHalf = sin(-std::pi/2)
  cosineZero = cos(0)
  cosinePi = cos(std::pi)
  tangentZero = tan(0)
  tangentPiFourth = tan(std::pi/4)
  print("Sine/Cos/Tan examples:", sineZero, sinePiHalf, sineMinusPiHalf, cosineZero, cosinePi, tangentZero, tangentPiFourth)

  # [2] Additional Trigonometric Functions
  cotangentPiFourth = cot(std::pi/4)
  secantZero = sec(0)
  cosecantPiHalf = csc(std::pi/2)
  print("cot/sec/csc:", cotangentPiFourth, secantZero, cosecantPiHalf)

  # [3] Trigonometric Identities
  angle = 0.7
  sinSquaredPlusCosSquared = sin(angle)^2 + cos(angle)^2
  tanIdentity = sin(angle)/cos(angle)
  tanDirect = tan(angle)
  print("Identity checks:", sinSquaredPlusCosSquared, tanIdentity, tanDirect)

  # [4] Working with Radians and Degrees
  degToRad = |degrees| degrees * std::pi / 180
  radToDeg = |radians| radians * 180 / std::pi
  angle45Rad = degToRad(45)
  sin45 = sin(angle45Rad)
  print("45° in radians and sin(45°):", angle45Rad, sin45)

  # [6] Trigonometric Functions with Complex Arguments
  sineComplex = sin(1 + 2i)
  cosineComplex = cos(1 + 2i)
  print("Complex trig:", sineComplex, cosineComplex)

  # [7] Practical Applications
  circleX = |angle| cos(angle)
  circleY = |angle| sin(angle)
  pointAt0 = [circleX(0), circleY(0)]
  pointAtPiHalf = [circleX(std::pi/2), circleY(std::pi/2)]
  print("Circle points:", pointAt0, pointAtPiHalf)

  # [8] Vector Applications
  angles = [0, std::pi/6, std::pi/4, std::pi/3, std::pi/2]
  sineValues = map(angles, |x| sin(x))
  cosineValues = map(angles, |x| cos(x))
  print("Sine values:", sineValues)
  print("Cosine values:", cosineValues)

  print("=== Trigonometric examples completed ===")
}

# Run the examples
runTrigonometricExamples()
