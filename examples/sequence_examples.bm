# Sequence Operations Examples
# ==========================
# This file demonstrates lazy sequence operations in BMath language.

use "std" as std
use std::{print, seq, map, filter, collect, take, zip, reduce, sum, nth}

runSequenceExamples = || {
  print("=== Sequence Examples ===")

  # [1] Creating Sequences
  finiteSeq = seq(5, |i| i * 2)
  vectorSeq = seq([1, 2, 3, 4, 5])
  naturalNumbers = seq(|i| i)
  constantSeq = seq(42)
  print("Finite seq collected:", finiteSeq->collect)

  # [2] Sequence Generation Examples
  fibonacciSeq = |n| {
    a = 0
    b = 1
    seq(n, |i| {
      temp = b
      b = a + b
      a = temp
    })
  }

  factorialSeq = |n| {
    fact = 1
    seq(n, |i| {
      fact = fact * (i + 1)
    })
  }

  # [3] Accessing Sequence Elements
  fib10 = fibonacciSeq(10) -> skip(9)
  fact5 = factorialSeq(5) -> skip(4)
  fibVector = fibonacciSeq(8) -> collect
  print("fib10/fact5:", fib10, fact5)
  print("First 8 fibs:", fibVector)

  # [4] Sequence Transformations
  doubledFibs = fibonacciSeq(8) -> map(|x| x * 2) -> collect
  evenFibs = fibonacciSeq(12) -> filter(|x| x % 2 == 0) -> collect
  print("Doubled fibs:", doubledFibs)
  print("Even fibs:", evenFibs)

  # [5] Complex Sequence Processing
  processedSeq = naturalNumbers -> map(|x| x * x) -> filter(|x| x % 2 == 0) -> map(|x| x / 2) -> take(5) -> collect
  print("Processed seq:", processedSeq)

  # [6] Combining Sequences
  zipSequence = seq(5, |i| i) -> zip(seq(5, |i| i * 10)) -> collect
  print("Zipped seq:", zipSequence)

  # [7] Sequence Reductions
  sumFirst100 = seq(100, |i| i + 1) -> sum
  productFirst5 = seq(5, |i| i + 1) -> reduce(1, |acc, x| acc * x)
  print("Sum first 100:", sumFirst100, "Product first 5:", productFirst5)

  # [8] Infinite Sequence Caution
  perfectSquares = naturalNumbers -> map(|x| x * x) -> take(10) -> collect
  print("Perfect squares:", perfectSquares)

  # [9] Custom Sequence Operations
  runningAvg = |numbers| {
    local sum = 0
    seq(len(numbers), |i| {
      sum = sum + nth(numbers, i)
      sum / (i + 1)
    }) -> collect
  }
  avgResult = runningAvg([2, 4, 6, 8, 10])
  print("Running averages:", avgResult)

  print("=== Sequence examples completed ===")
}

# Run the examples
runSequenceExamples()
