# Numeric Examples in BMath Language
# ================================
# This file demonstrates different numeric types and their operations.

use "std" as std
use std::{print, sqrt, abs, floor, ceil, round}

runNumericExamples = || {
  print("=== Numeric Examples ===")

  # [1] Integer Literals and Operations
  intValue = 42
  negativeInt = -7
  zeroInt = 0
  intSum = 15 + 27
  intDiff = 100 - 58
  intProd = 6 * 7
  intQuot = 84 / 2
  intMod = 100 % 58
  intPow = 2 ^ 5
  print("Ints:", intValue, negativeInt, intSum, intDiff, intProd, intQuot, intMod, intPow)

  # [2] Floating-Point Literals and Operations
  floatValue = 3.14159
  negativeFloat = -2.71828
  scientificNotation = 6.022e23
  floatSum = 3.14 + 2.86
  floatProd = 3.14 * 2
  floatDiv = 10.5 / 2.5
  floatPow = 2.0 ^ 3.0
  print("Floats:", floatValue, negativeFloat, scientificNotation, floatSum, floatProd, floatDiv, floatPow)

  # [3] Mixed Integer and Float Operations
  mixedSum = 5 + 3.5
  mixedProd = 4 * 2.5
  mixedDiv = 10 / 4
  mixedPow = 2 ^ 2.5
  print("Mixed:", mixedSum, mixedProd, mixedDiv, mixedPow)

  # [4] Complex Number Literals and Operations
  complexNumber = 3 + 4i
  pureImaginary = 5i
  complexFromReal = 7 + 0i
  complexSum = (3 + 4i) + (2 - 3i)
  complexDiff = (3 + 4i) - (2 - 3i)
  complexProd = (3 + 4i) * (2 - 3i)
  complexDiv = (3 + 4i) / (2 - 3i)
  complexAbs = abs(3 + 4i)
  complexSqrt = sqrt(-9)
  print("Complexes:", complexNumber, pureImaginary, complexFromReal, complexSum, complexDiff, complexProd, complexDiv)
  print("Complex abs & sqrt:", complexAbs, complexSqrt)

  # [5] Numeric Type Promotion
  promotion1 = 1 + 2.5
  promotion2 = 2.5 + 3i
  promotion3 = 2 * (3 + 4i)
  print("Promotions:", promotion1, promotion2, promotion3)

  # [6] Numeric Precision and Limits
  floatPrecision = 0.1 + 0.2
  floatComparison = (0.1 + 0.2) == 0.3
  largeNumber = 1e30
  smallNumber = 1e-30
  largeTimesSmall = largeNumber * smallNumber
  print("Precision and limits:", floatPrecision, floatComparison, largeNumber, smallNumber, largeTimesSmall)

  # [7] Number Conversions
  intToFloat = 42 + 0.0
  floatToInt = floor(3.7)
  print("Conversions:", intToFloat, floatToInt)

  # [8] Special Numeric Functions
  absValue = abs(-42)
  absComplex = abs(3 + 4i)
  sqrtValue = sqrt(16)
  sqrtFloat = sqrt(2)
  roundValue = round(3.5)
  floorValue = floor(3.7)
  ceilValue = ceil(3.2)
  print("Specials:", absValue, absComplex, sqrtValue, sqrtFloat, roundValue, floorValue, ceilValue)

  # [9] Numeric Vector Operations
  intVector = [1, 2, 3]
  floatVector = [1.5, 2.5, 3.5]
  complexVector = [1+i, 2+2i, 3+3i]
  mixedVectorSum = intVector + floatVector
  vectorScalarProd = 2 * intVector
  complexVectorProd = 2i * intVector
  print("Vector ops:", mixedVectorSum, vectorScalarProd, complexVectorProd)

  # [10] Numeric Expressions with Mixed Types
  expression1 = (1 + 2i) * (3 + 4.5) / 2
  expression2 = sqrt(16) + sqrt(-16)
  print("Expressions:", expression1, expression2)

  print("=== Numeric examples completed ===")
}

# Run the examples
runNumericExamples()
