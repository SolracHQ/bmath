      "body": ["[${1:item1}, ${2:item2}, ${3:item3}]$0"],
      "description": "Create a vector literal"
    },
    {
      "name": "Empty Vector",
      "prefix": "vecempty",
      "body": ["[]$0"],
      "description": "Create an empty vector"
    },
    {
      "name": "Range Vector",
      "prefix": "range",
      "body": ["range(${1:start}, ${2:end})$0"],
