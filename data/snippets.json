      "body": ["println(${1:value})$0"],
      "description": "Print a value with newline"
    },
    {
      "name": "Complex Number",
      "prefix": "complex",
      "body": ["${1:real} + ${2:imaginary}i$0"],
      "description": "Create a complex number"
    },
    {
      "name": "Pure Imaginary",
