      "prefix": "mod",
      "body": ["mod ${1:name} {", "  ${2:body}$0", "}"],
      "description": "Create a module definition"
    },
    {
      "name": "Anonymous Module",
      "prefix": "amod",
      "body": ["mod {", "  ${1:body}$0", "}"],
      "description": "Create an anonymous module"
    },
    {
