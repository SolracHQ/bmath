    {
      "name": "Use with Alias",
      "prefix": "useas",
      "body": ["use(${1:module} as ${2:alias})$0"],
      "description": "Import a module with an alias"
    },
    {
      "name": "Chain Expression",
      "prefix": "chain",
      "body": ["${1:value} -> ${2:function}$0"],
      "description": "Create a chain expression with arrow operator"
    },
    {
      "name": "Multi-step Chain",
      "prefix": "chainm",
      "body": [
        "${1:value} \\",
        "  -> ${2:function1} \\",
        "  -> ${3:function2}$0"
      ],
      "description": "Create a multi-step chain expression with backslashes"
    },
    {
      "name": "Map Operation",
      "prefix": "map",
      "body": ["${1:collection} -> map(|${2:item}| ${3:transformation})$0"],
      "description": "Map over a collection"
    },
    {
      "name": "Filter Operation",
      "prefix": "filter",
      "body": ["${1:collection} -> filter(|${2:item}| ${3:condition})$0"],
      "description": "Filter a collection"
    },
    {
      "name": "Reduce Operation",
      "prefix": "reduce",
      "body": [
        "${1:collection} -> reduce(|${2:acc}, ${3:item}| ${4:operation}, ${5:initial})$0"
      ],
      "description": "Reduce a collection"
    },
    {
      "name": "Map-Filter-Reduce Chain",
      "prefix": "mfr",
      "body": [
        "${1:collection} \\",
        "  -> map(|${2:x}| ${3:transform}) \\",
        "  -> filter(|${4:x}| ${5:condition}) \\",
        "  -> reduce(|${6:acc}, ${7:x}| ${8:operation}, ${9:initial})$0"
      ],
      "description": "Common map-filter-reduce pipeline"
    },
    {
