      "prefix": "type",
      "body": [
        "${1:variable}: ${2|Int,Real,Complex,Bool,Vec,Seq,Function,String,Module,Any,Number,Type|}$0"
      ],
      "description": "Add type annotation"
    },
    {
      "name": "Type Check",
      "prefix": "is",
      "body": ["${1:value} is ${2:Type}$0"],
