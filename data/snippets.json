{
  "version": "0.12.0",
  "snippets": [
    {
      "name": "Immutable Variable Declaration",
      "prefix": "let",
      "body": ["${1:variable} := ${2:value}$0"],
      "description": "Declare an immutable variable"
    },
    {
      "name": "Mutable Variable Declaration",
      "prefix": "mut",
      "body": ["${1:variable} ;= ${2:value}$0"],
      "description": "Declare a mutable variable"
    },
    {
      "name": "Typed Immutable Declaration",
      "prefix": "lett",
      "body": ["${1:variable}: ${2:Type} := ${3:value}$0"],
      "description": "Declare an immutable variable with type annotation"
    },
    {
      "name": "Typed Mutable Declaration",
      "prefix": "mutt",
      "body": ["${1:variable}: ${2:Type} ;= ${3:value}$0"],
      "description": "Declare a mutable variable with type annotation"
    },
    {
      "name": "Function Literal",
      "prefix": "fn",
      "body": ["|${1:param}| ${2:body}$0"],
      "description": "Create a function literal"
    },
    {
      "name": "Multi-Parameter Function",
      "prefix": "fnm",
      "body": ["|${1:param1}, ${2:param2}| ${3:body}$0"],
      "description": "Create a multi-parameter function literal"
    },
    {
      "name": "Typed Function Parameter",
      "prefix": "fnt",
      "body": ["|${1:param}: ${2:Type}| ${3:body}$0"],
      "description": "Create a function literal with typed parameter"
    },
    {
      "name": "Typed Function Return",
      "prefix": "fnr",
      "body": ["|${1:param}| => ${2:ReturnType} ${3:body}$0"],
      "description": "Create a function literal with return type"
    },
    {
      "name": "No-Parameter Function",
      "prefix": "fn0",
      "body": ["|| ${1:body}$0"],
      "description": "Create a function with no parameters"
    },
    {
      "name": "If Expression",
      "prefix": "if",
      "body": ["if(${1:condition}) ${2:then_expr} else ${3:else_expr}$0"],
      "description": "Create an if expression"
    },
    {
      "name": "Multi-line If Expression",
      "prefix": "ifm",
      "body": [
        "if(${1:condition}) \\",
        "  ${2:then_expr} \\",
        "else \\",
        "  ${3:else_expr}$0"
      ],
      "description": "Create a multi-line if expression with backslashes"
    },
    {
      "name": "If-Elif-Else Expression",
      "prefix": "ife",
      "body": [
        "if(${1:condition1}) \\",
        "  ${2:then_expr1} \\",
        "elif(${3:condition2}) \\",
        "  ${4:then_expr2} \\",
        "else \\",
        "  ${5:else_expr}$0"
      ],
      "description": "Create an if-elif-else expression with backslashes"
    },
    {
      "name": "Block Expression",
      "prefix": "block",
      "body": ["{", "  ${1:expressions}$0", "}"],
      "description": "Create a block expression"
    },
    {
      "name": "Multi-line Block",
      "prefix": "blockm",
      "body": [
        "{",
        "  ${1:expr1}",
        "  ${2:expr2}",
        "  ${3:result}$0",
        "}"
      ],
      "description": "Create a multi-expression block"
