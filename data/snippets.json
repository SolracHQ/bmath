    {
      "name": "Assert Type",
      "prefix": "asserttype",
      "body": ["assert_type(${1:value}, ${2:Type}, ${3:\"message\"})$0"],
      "description": "Assert value has expected type"
    },
    {
      "name": "Try-Or Expression",
      "prefix": "tryor",
      "body": ["try_or(${1:expression}, ${2:default_value})$0"],
      "description": "Try an expression with a default fallback"
    },
    {
      "name": "Try-Catch Expression",
      "prefix": "try",
      "body": ["try_catch(${1:expression}, ${2:\"fallback_message\"})$0"],
      "description": "Try an expression with error handling"
    },
    {
      "name": "Print Statement",
      "prefix": "print",
      "body": ["print(${1:value})$0"],
      "description": "Print a value"
    },
    {
      "name": "Print Line",
